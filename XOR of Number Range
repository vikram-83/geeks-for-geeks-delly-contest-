
class Solution {
public:
    int findXOR(int l, int r) {

        auto xorUpto = [](int n) {
            if (n % 4 == 0) return n;
            if (n % 4 == 1) return 1;
            if (n % 4 == 2) return n + 1;
            return 0;
        };

        return xorUpto(r) ^ xorUpto(l - 1);
    }
};

Input: l = 4, r = 8 
Output: 8 
Explanation: The XOR of all integers from 4 to 8 is (4 xor 5 xor 6 xor 7 xor 8) = 8.
