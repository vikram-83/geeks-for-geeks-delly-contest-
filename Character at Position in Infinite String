class Solution {
public:
    char posInfinite(string &s, int pos) {
        int n = s.length();

        while (pos > n) {
            int i = 1;

            while (pos > n + i + n) {
                n = 2 * n + i;
                i++;
            }

            if (pos > n + i) {
                pos = 2 * n + i - pos + 1;
            }
            else {
                return '$';
            }
        }

        return s[pos - 1];
    }
};

Input: s = "12345", pos = 3
Output: 3
Explanation: In "12345...", the character at pos 3 is 3.
