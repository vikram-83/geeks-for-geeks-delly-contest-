Input: s = "abc", k = 1
Output: 3
Explanation: The characters 'a', 'b' and 'c' each appear in exactly one group.

class Solution {
public:
    int getCount(string &s, int k) {

        int freq[26] = {0};

        for (int i = 0; i < s.size(); i++) {

            if (i == 0 || s[i] != s[i - 1]) {

                freq[s[i] - 'a']++;
            }
        }

        int count = 0;

        for (int i = 0; i < 26; i++) {

            if (freq[i] == k) {
                count++;
            }
        }

        return count;
    }
};
