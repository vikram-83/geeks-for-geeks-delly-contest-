
class Solution {
public:
    vector<int> countVowels(string &s,
                            vector<vector<int>> &queries) {

        int n = s.size();

        vector<int> prefix(n + 1, 0);

        // Step 1: Build Prefix Sum
        for(int i = 0; i < n; i++) {

            prefix[i + 1] = prefix[i];

            if(s[i] == 'a' || s[i] == 'e' ||
               s[i] == 'i' || s[i] == 'o' ||
               s[i] == 'u') {

                prefix[i + 1]++;
            }
        }

        // Step 2: Answer Queries
        vector<int> ans;

        for(auto &q : queries) {

            int l = q[0];
            int r = q[1];

            int count = prefix[r + 1] - prefix[l];

            ans.push_back(count);
        }

        return ans;
    }
};
