class Solution {
  public:
    int countOfElements(int x, vector<int> &arr) {

        int count = 0;

        for(int i = 0; i < arr.size(); i++) {

            if(arr[i] <= x) {
                count++;
            }
        }

        return count;
    }
};

Input: x = 9, arr[] = [10, 1, 2, 8, 4, 5] 
Output: 5
Explanation: The 5 elements are 1, 2, 8, 4 and 5.
