Minimum Time with 2 ScannerMinimum Time with 2 Scanner
Input: n = 2, s1 = 2, s2 = 4
Output: 4
Explanation: We can either scan both documents using scanner 1,
which takes 2 × 2 = 4 units of time, or scan one document using each scanner simultaneously, which takes max(2, 4) = 4 units of time. Both approaches require 4 units of time.
class Solution {
  public:
    int minTime(int n, int s1, int s2) {

        long long low = 0;
        long long high = 1LL * n * min(s1, s2);
        long long ans = high;

        while (low <= high) {

            long long mid = low + (high - low) / 2;

            // Documents scanned by both scanners
            long long total = mid / s1 + mid / s2;

            if (total >= n) {
                ans = mid;
                high = mid - 1;
            }
            else {
                low = mid + 1;
            }
        }

        return (int)ans;
    }
};
