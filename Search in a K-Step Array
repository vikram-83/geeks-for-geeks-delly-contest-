
class Solution {
public:
    int findStepKeyIndex(vector<int>& arr, int k, int x) {
        int n = arr.size();
        int i = 0;

        while (i < n) {
            if (arr[i] == x) {
                return i;
            }

            int jump = max(1, abs(arr[i] - x) / k);

            i += jump;
        }

        return -1;
    }
};


Input: arr[] = [4, 5, 6, 7, 6], k = 1, x = 6
Output: 2
Explanation: In the array arr, 6 is present at index 2. So, return 2.
