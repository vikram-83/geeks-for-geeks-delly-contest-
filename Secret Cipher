Input: s = "ababcababcd"
Output: ab*c*d
Explanation: We can encrypt the string in following way : "ababcababcd" -> "ababc*d" -> "ab*c*d


class Solution {
public:
    string compress(string &s) {
        int n = s.length();
        if (n == 0) return "";

        // Compute KMP LPS array for the string s
        vector<int> lps(n, 0);
        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];
            while (j > 0 && s[i] != s[j]) {
                j = lps[j - 1];
            }
            if (s[i] == s[j]) {
                j++;
            }
            lps[i] = j;
        }

        string result = "";
        int i = n - 1;

        // Compress greedily from right to left
        while (i >= 0) {
            int len = i + 1;

            // Check if length is even and can be split into two identical halves
            if (len % 2 == 0) {
                int half = len / 2;
                int j = lps[i];

                // Find the longest proper border length <= half
                while (j > half) {
                    j = lps[j - 1];
                }

                // If half matches the prefix of length 'half'
                if (j == half) {
                    result += '*';
                    i = half - 1; // Move pointer to end of the first half
                    continue;
                }
            }

            // Otherwise, append the character normally
            result += s[i];
            i--;
        }

        // Reverse to get correct left-to-right representation
        reverse(result.begin(), result.end());
        return result;
    }
};
